# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey

# Server-side API key (used for backend AI services)
GEMINI_API_KEY=your_api_key_here

# Client-side API key (used for voice features)
# WARNING: This key is exposed in the browser bundle
# SECURITY RECOMMENDATION: Use Google Cloud Console to restrict this key:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Select your API key
#   3. Add "HTTP referrers" restriction with your domain
#   4. Add "API restrictions" to limit to Gemini API only
NEXT_PUBLIC_GEMINI_API_KEY=your_api_key_here
