# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini Model - Available options:
# - gemini-2.0-flash-lite (recommended: fast, efficient, good quality)
# - gemini-1.5-pro (best quality, slower, higher cost)
# - gemini-1.5-flash (balanced: good quality, fast)
# - gemini-2.0-flash-exp (experimental: fastest)
GEMINI_MODEL=gemini-2.0-flash-lite
